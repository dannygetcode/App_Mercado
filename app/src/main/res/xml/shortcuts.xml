<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Acceso directo del lanzador: abre la compra (la empieza con el límite por defecto si no hay una). -->
    <shortcut
        android:shortcutId="new_trip"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_trip"
        android:shortcutShortLabel="@string/shortcut_new_trip"
        android:shortcutLongLabel="@string/shortcut_new_trip">
        <intent
            android:action="co.daniel.mercado.action.NEW_TRIP"
            android:targetPackage="co.daniel.mercado"
            android:targetClass="co.daniel.mercado.MainActivity" />
    </shortcut>
</shortcuts>
